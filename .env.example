# Copier ce fichier en .env puis remplir. Ne JAMAIS versionner le fichier .env.

# Base de données (Docker Compose : le service « db » ; en local : port 5434)
DATABASE_URL=postgresql+psycopg://aqua:aqua@localhost:5434/aquasentinelle
POSTGRES_PASSWORD=aqua

# Secret de l'application (64 caractères aléatoires) : chiffre les contacts et signe les sessions.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
# ATTENTION : le changer rend illisibles les contacts déjà enregistrés.
APP_SECRET_KEY=

# Adresse publique du serveur : c'est elle que contiennent les QR codes peints.
BASE_URL=http://localhost:8000

# Premier compte administrateur (créé au démarrage s'il n'existe pas)
ADMIN_IDENTIFIANT=admin
ADMIN_MOT_DE_PASSE=

# Planificateur : collecte de pluie + score + alertes toutes les N minutes
PLANIFICATEUR_ACTIF=true
PLANIFICATEUR_MINUTES=60
ESCALADE_MINUTES=15
ANTI_DOUBLON_HEURES=6
PLAFOND_ENVOIS_JOUR=5

# Satellite IMERG Early (NASA) : jeton sur urs.earthdata.nasa.gov (gratuit), autoriser l'application GES DISC.
# IMERG est stocké et affiché ; il n'entre dans le score qu'avec IMERG_DANS_SCORE=true, après calibration.
EARTHDATA_TOKEN=
IMERG_DANS_SCORE=false

# Telegram : créer un bot avec @BotFather
TELEGRAM_TOKEN=
TELEGRAM_BOT_NOM=

# SMS : africastalking (sandbox ou production) ou passerelle (téléphone Android)
SMS_FOURNISSEUR=
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_PASSERELLE_URL=
SMS_PASSERELLE_IDENTIFIANT=
SMS_PASSERELLE_MOT_DE_PASSE=

# IA de vision locale (Ollama) : second regard sur les photos. Désactiver avec IA_VISION_ACTIVE=false.
IA_VISION_ACTIVE=true
OLLAMA_MODELE_VISION=gemma4:e4b
